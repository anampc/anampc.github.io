<ul class="cv-compact">
  {% assign publications = data[1] | sort: 'releaseDate' | reverse %}
  {% for content in publications %}
    <li class="cv-item">
      <div class="cv-date">{{ content.releaseDate }}</div>
      <div class="cv-body">
        <span class="cv-title">{% if content.url %}<a href="{{ content.url }}">{{ content.title }}</a>{% else %}{{ content.title }}{% endif %}</span>
        <div class="cv-meta">{{ content.authors }} · <i>{{ content.publisher }}</i></div>
      </div>
    </li>
  {% endfor %}
</ul>
