<ul class="cv-compact">
  {% assign presentations = data[1] | sort: 'presDate' | reverse %}
  {% for content in presentations %}
    <li class="cv-item">
      <div class="cv-date">{{ content.presDate }}</div>
      <div class="cv-body">
        {% if content.title %}<span class="cv-meta">{% if content.url %}<a href="{{ content.url }}">{{ content.title }}</a>{% else %}{{ content.title }}{% endif %} · </span>{% endif %}<span class="cv-title">{{ content.conference }}</span>
      </div>
    </li>
  {% endfor %}
</ul>
