<ul class="cv-compact">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    {% assign start = content.startDate | split: '-' | first %}
    {% if content.endDate == 'Present' or content.endDate == nil %}{% assign end = 'Present' %}{% else %}{% assign end = content.endDate | split: '-' | first %}{% endif %}
    <li class="cv-item">
      <div class="cv-date">{{ start }}–{{ end }}</div>
      <div class="cv-body">
        <span class="cv-title">{% if content.url %}<a href="{{ content.url }}">{{ content.position }}</a>{% else %}{{ content.position }}{% endif %}</span>
        <span class="cv-meta"> · {{ content.name }}</span>
        {% if content.highlights.size > 0 %}
          <ul class="cv-bullets">
            {% for item in content.highlights %}<li>{{ item }}</li>{% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
