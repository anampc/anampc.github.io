<ul class="cv-compact">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="cv-item">
      <div class="cv-date">{{ content.startDate | split: '-' | first }}–{{ content.endDate | split: '-' | first }}</div>
      <div class="cv-body">
        <span class="cv-title">{{ content.studyType }}</span>
        <span class="cv-meta"> · {% if content.url %}<a href="{{ content.url }}">{{ content.institution }}</a>{% else %}{{ content.institution }}{% endif %}{% if content.location %}, {{ content.location }}{% endif %}</span>
        {% if content.thesis %}<div class="cv-meta"><i>{{ content.thesis }}</i></div>{% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
