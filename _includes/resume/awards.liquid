<ul class="cv-compact">
  {% for content in data[1] %}
    <li class="cv-item">
      <div class="cv-date">{{ content.date }}</div>
      <div class="cv-body">
        <span class="cv-title">{% if content.url %}<a href="{{ content.url }}">{{ content.title }}</a>{% else %}{{ content.title }}{% endif %}</span>
        {% if data[0] == 'awards' %}
          {% if content.awarder %}<span class="cv-meta"> · {{ content.awarder }}</span>{% endif %}
        {% else %}
          <div class="cv-meta">{{ content.awarder }}{% if content.summary %} · {{ content.summary }}{% endif %}</div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
